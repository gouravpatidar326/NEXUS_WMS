generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(uuid())
  name      String
  industry  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  categories         Category[]
  products           Product[]
  batches            Batch[]
  locations          Location[]
  locationInventory  LocationInventory[]
  inventories        Inventory[]
  receivings         Receiving[]
  inventoryLedgers   InventoryLedger[]
  transfersOut       TransferOrder[] @relation("SourceCompany")
  transfersIn        TransferOrder[] @relation("DestCompany")
  inventoryTransfers InventoryTransfer[]
  stockAdjustments   StockAdjustment[]
  expiryAlerts       ExpiryAlert[]
  purchaseOrders     PurchaseOrder[]
  pickLists          PickList[]
  salesOrders        SalesOrder[]
  notifications      Notification[]
  shipments          Shipment[]
  warehouses         Warehouse[]
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   // SUPER_ADMIN, WAREHOUSE_MANAGER, INVENTORY_CLERK, CLIENT
  status    String   @default("ACTIVE")
  companyId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company            Company? @relation(fields: [companyId], references: [id])
  auditLogs          AuditLog[]
  notifications      Notification[]
  receivings         Receiving[]         @relation("InspectorUser")
  createdTransfers   InventoryTransfer[] @relation("TransferCreatedUser")
  createdAdjustments StockAdjustment[]   @relation("AdjustmentCreatedUser")
}

model Client {
  id          String   @id @default(uuid())
  name        String
  creditLimit Float    @default(0.0)
  tier        String   @default("STANDARD")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  salesOrders SalesOrder[]
}

model AuditLog {
  id        String   @id @default(uuid())
  event     String
  userId    String?
  ipAddress String?
  timestamp DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])
}

model SystemSettings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model Category {
  id          String    @id @default(uuid())
  name        String
  code        String?
  description String?
  companyId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company  Company   @relation(fields: [companyId], references: [id])
  products Product[]
}

// Catalog-only Product model (stock is driven by LocationInventory & InventoryLedger)
model Product {
  id             String    @id @default(uuid())
  sku            String
  barcode        String?
  name           String
  description    String?
  category       String?   // Backward compatible string category
  categoryId     String?
  unitCost       Float     @default(0.0)
  wholesalePrice Float     @default(0.0)
  brand          String?
  uom            String    @default("Piece")
  storageType    String    @default("General Storage")
  trackingMethod String    @default("None")
  status         String    @default("ACTIVE")
  availableStock Int       @default(0)
  committedStock Int       @default(0)
  companyId      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  company             Company             @relation(fields: [companyId], references: [id])
  categoryRef         Category?           @relation(fields: [categoryId], references: [id])
  inventory           InventoryLedger[]
  batches             Batch[]
  locationInventories LocationInventory[]
  inventories         Inventory[]
  barcodes            Barcode[]
  receivingItems      ReceivingItem[]
  transferItems       TransferItem[]
  stockAdjustments    StockAdjustment[]
  expiryAlerts        ExpiryAlert[]
  transferOrders      TransferOrder[]
  pickListItems       PickListItem[]
  salesOrderItems     SalesOrderItem[]
  purchaseOrderItems  PurchaseOrderItem[]
  specification       ProductSpecification?
}

model ProductSpecification {
  id        String @id @default(uuid())
  productId String @unique
  weight    Float?
  length    Float?
  width     Float?
  height    Float?
  volume    Float?

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Receiving {
  id              String   @id @default(uuid())
  receivingNumber String   @unique
  poNumber        String?
  supplier        String
  warehouse       String?  // Associated Facility name
  status          String   @default("PENDING") // PENDING, IN_INSPECTION, COMPLETED, REJECTED
  receivedAt      DateTime @default(now())
  inspectorId     String?
  notes           String?
  companyId       String
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company   Company         @relation(fields: [companyId], references: [id])
  inspector User?           @relation("InspectorUser", fields: [inspectorId], references: [id])
  items     ReceivingItem[]
}

model ReceivingItem {
  id              String   @id @default(uuid())
  receivingId     String
  productId       String
  expectedQty     Int
  receivedQty     Int      @default(0)
  acceptedQty     Int      @default(0)
  rejectedQty     Int      @default(0)
  rejectionReason String?
  companyId       String
  createdAt       DateTime @default(now())

  receiving Receiving @relation(fields: [receivingId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  batches   Batch[]
}

model Batch {
  id                String    @id @default(uuid())
  lotNumber         String?   
  lotId             String?   
  productId         String
  receivingItemId   String?
  companyId         String
  mfgDate           DateTime?
  expiryDate        DateTime?
  acceptedQty       Int       @default(0)
  status            String    @default("QUARANTINE") // QUARANTINE, RELEASED, REJECTED, EXPIRED
  quarantine        Boolean   @default(false)
  coaLocked         Boolean   @default(true)
  testCertificateId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  product             Product             @relation(fields: [productId], references: [id])
  company             Company             @relation(fields: [companyId], references: [id])
  receivingItem       ReceivingItem?      @relation(fields: [receivingItemId], references: [id])
  barcodes            Barcode[]
  locationInventories LocationInventory[]
  inventoryLedgers    InventoryLedger[]
  transferItems       TransferItem[]
  stockAdjustments    StockAdjustment[]
  expiryAlerts        ExpiryAlert[]
  pickListItems       PickListItem[]
}

model Barcode {
  id          String   @id @default(uuid())
  code        String   @unique
  barcodeType String   @default("CODE128") // CODE128, QR
  productId   String
  batchId     String
  companyId   String
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  batch   Batch   @relation(fields: [batchId], references: [id])
}

model Location {
  id          String    @id @default(uuid())
  code        String?   
  name        String?
  warehouse   String    @default("Main Warehouse")
  zone        String
  aisle       String
  rack        String
  shelf       String
  bin         String    @default("A1")
  capacityType String   @default("Items")
  maxCapacity Int       @default(1000)
  occupied    Int       @default(0)
  status      String    @default("Active")
  companyId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company             Company             @relation(fields: [companyId], references: [id])
  locationInventories LocationInventory[]
  inventoryLedgers    InventoryLedger[]
  sourceTransfers     InventoryTransfer[] @relation("SourceLocation")
  destTransfers       InventoryTransfer[] @relation("DestLocation")
  stockAdjustments    StockAdjustment[]
}

model Warehouse {
  id             String   @id @default(uuid())
  name           String
  code           String?
  address        String?
  city           String?
  state          String?
  country        String?
  zipCode        String?
  managerName    String?
  contactPhone   String?
  capacityType   String?  // Items, Kg, Pallets, CBM
  capacityValue  Float?
  facilityType   String?  // e.g. "Cold Storage", "Hazardous", "General"
  supportedItems String?  // e.g. "Perishables, Pharmaceuticals"
  companyId      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company             Company             @relation(fields: [companyId], references: [id])
  locationInventories LocationInventory[]
}

model LocationInventory {
  id         String   @id @default(uuid())
  locationId String
  productId  String
  lotId        String?
  warehouseId  String?
  quantity     Int      @default(0)
  reserved     Int      @default(0)
  available    Int      @default(0)
  lotNumber    String?
  batchNumber  String?
  serialNumber String?
  expiryDate   DateTime?
  companyId    String
  createdAt    DateTime @default(now())
  updatedAt  DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])
  batch    Batch?   @relation(fields: [lotId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])
  company  Company  @relation(fields: [companyId], references: [id])

  @@unique([locationId, productId, lotId])
}

model Inventory {
  id             String   @id @default(uuid())
  productId      String
  companyId      String
  totalStock     Int      @default(0)
  reservedStock  Int      @default(0)
  availableStock Int      @default(0)
  updatedAt      DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([productId, companyId])
}

model InventoryLedger {
  id               String   @id @default(uuid())
  productId        String
  lotId            String?
  companyId        String
  locationId       String?
  sourceLocationId String?
  destLocationId   String?
  location         String?  // Legacy string location fallback
  quantityDelta    Int      // Positive for IN, Negative for OUT
  movementType     String   // RECEIVE, TRANSFER, RETURN, ADJUSTMENT, PICK, SHIP
  referenceId      String?
  notes            String?
  createdBy        String?
  timestamp        DateTime @default(now())

  product  Product   @relation(fields: [productId], references: [id])
  batch    Batch?    @relation(fields: [lotId], references: [id])
  company  Company   @relation(fields: [companyId], references: [id])
  locRef   Location? @relation(fields: [locationId], references: [id])
}

model InventoryTransfer {
  id               String   @id @default(uuid())
  transferNumber   String   @unique
  transferType     String   @default("BIN_TO_BIN") // BIN_TO_BIN, WAREHOUSE_TO_WAREHOUSE
  sourceLocationId String
  destLocationId   String
  status           String   @default("PENDING") // PENDING, COMPLETED, CANCELLED
  companyId        String
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company        Company        @relation(fields: [companyId], references: [id])
  sourceLocation Location       @relation("SourceLocation", fields: [sourceLocationId], references: [id])
  destLocation   Location       @relation("DestLocation", fields: [destLocationId], references: [id])
  creator        User?          @relation("TransferCreatedUser", fields: [createdBy], references: [id])
  items          TransferItem[]
}

model TransferItem {
  id         String @id @default(uuid())
  transferId String
  productId  String
  lotId      String
  quantity   Int

  transfer InventoryTransfer @relation(fields: [transferId], references: [id])
  product  Product           @relation(fields: [productId], references: [id])
  batch    Batch             @relation(fields: [lotId], references: [id])
}

model StockAdjustment {
  id               String   @id @default(uuid())
  adjustmentNumber String   @unique
  productId        String
  lotId            String
  locationId       String
  quantityDelta    Int
  reasonCode       String   // DAMAGE, LOST, MANUAL_CORRECTION, AUDIT_CORRECTION
  notes            String?
  createdBy        String?
  companyId        String
  createdAt        DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id])
  batch    Batch    @relation(fields: [lotId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  creator  User?    @relation("AdjustmentCreatedUser", fields: [createdBy], references: [id])
  company  Company  @relation(fields: [companyId], references: [id])
}

model ExpiryAlert {
  id            String   @id @default(uuid())
  lotId         String
  productId     String
  expiryDate    DateTime
  daysRemaining Int
  alertTier     String   // ALERT_30D, ALERT_15D, ALERT_7D, EXPIRED
  resolved      Boolean  @default(false)
  companyId     String
  createdAt     DateTime @default(now())

  batch   Batch   @relation(fields: [lotId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
}

model PurchaseOrder {
  id               String   @id @default(uuid())
  poNumber         String   @unique
  supplier         String
  expectedDelivery DateTime?
  totalCost        Float    @default(0.0)
  status           String   @default("PENDING") // PENDING, APPROVED, RECEIVED
  companyId        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company Company             @relation(fields: [companyId], references: [id])
  items   PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String @id @default(uuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  unitCost        Float  @default(0.0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])
}

model TransferOrder {
  id                   String   @id @default(uuid())
  sourceCompanyId      String
  destinationCompanyId String
  productId            String
  quantity             Int
  status               String   @default("PENDING") // PENDING, DISPATCHED, RECEIVED
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  sourceCompany      Company @relation("SourceCompany", fields: [sourceCompanyId], references: [id])
  destinationCompany Company @relation("DestCompany", fields: [destinationCompanyId], references: [id])
  product            Product @relation(fields: [productId], references: [id])
}

model PickList {
  id        String   @id @default(uuid())
  orderId   String
  status    String   @default("PENDING") // PENDING, PICKING, COMPLETED
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company        @relation(fields: [companyId], references: [id])
  items   PickListItem[]
}

model PickListItem {
  id             String  @id @default(uuid())
  pickListId     String
  productId      String
  batchId        String?
  binLocation    String
  targetQuantity Int
  pickedQuantity Int     @default(0)
  picked         Boolean @default(false)

  pickList PickList @relation(fields: [pickListId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])
  batch    Batch?   @relation(fields: [batchId], references: [id])
}

model SalesOrder {
  id              String   @id @default(uuid())
  orderNumber     String?  @unique
  clientId        String
  companyId       String
  priority        String?  @default("NORMAL")
  status          String   @default("PENDING_REVIEW") // PENDING_REVIEW, PICKING, REJECTED, COMPLETED
  rejectionReason String?
  totalCost       Float    @default(0.0)
  shippingAddress String?
  poNumber        String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client  Client           @relation(fields: [clientId], references: [id])
  company Company          @relation(fields: [companyId], references: [id])
  items   SalesOrderItem[]
}

model SalesOrderItem {
  id           String @id @default(uuid())
  salesOrderId String
  productId    String
  quantity     Int

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  companyId String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user    User?   @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
}

model Shipment {
  id                String   @id @default(uuid())
  trackingNumber    String   @unique
  carrier           String
  orderId           String
  recipient         String
  destination       String
  estimatedDelivery String?
  status            String   @default("LABEL_CREATED")
  labelUrl          String?
  companyId         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
}
